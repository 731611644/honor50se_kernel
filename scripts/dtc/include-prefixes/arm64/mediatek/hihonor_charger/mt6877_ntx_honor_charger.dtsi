&charger {
	ac_charger_current = <2500000>;
	ac_charger_input_current = <2300000>;
	fcp_charger_current = <2200000>;
	fcp_charger_input_current = <1400000>;
	non_std_ac_charger_current = <1200000>;
	pd_vbus_upper_bound = <9000000>;
	max_charger_voltage = <12000000>;
	bc12_charger = <0>; /* mt6360 do bc12 */
	dpm_enable;
	battery_cv = <4450000>;
	sdp_battery_cv = <4430000>;
	iterm = <150000>;
	vbus_max_limit = <11500>;
	jeita_temp_above_t4_cv = <4100000>;
	jeita_temp_t3_to_t4_cv = <4100000>;
	jeita_temp_t2_to_t3_cv = <4450000>;
	jeita_temp_t1_to_t2_cv = <4430000>;
	jeita_temp_t0_to_t1_cv = <4430000>;
	jeita_temp_below_t0_cv = <4100000>;
	jeita_temp_t3_to_t4_cur = <1400000>;
	jeita_temp_t2_to_t3_cur = <2800000>;
	jeita_temp_t1_to_t2_cur = <1200000>;
	jeita_temp_t0_to_t1_cur = <420000>;
	dynamic_iterm_en;
	jeita_temp_t0_to_t1_iterm = <150000>;
	jeita_temp_t1_to_t2_iterm = <150000>;
	jeita_temp_t2_to_t3_iterm = <500000>;
	jeita_temp_t3_to_t4_iterm = <150000>;
	/* mode jeita param */
	support_over_volt = <1>;
	jeita_normal_temp_iterm = <500000>;
	jeita_normal_temp_cv = <4450000>;
	jeita_iin_therm_iterm = <150000>;
	jeita_iin_therm_cv = <4430000>;
	sdp_jeita_temp_t2_to_t3_cv = <4430000>;
	sdp_jeita_temp_t2_to_t3_iterm = <150000>;
	vdpm_buf_limit = <100>;
	vdpm_para =
			"-32767", "4000", "4300", "50",
			"4000", "4200", "4500", "50",
			"4200", "32767", "4600", "50";
	charge_full_design = <4300000>;
};

&pio {
	bq25970_main_irq_pins_default: bq25970_main_irq_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO23__FUNC_GPIO23>;
			slew-rate = <0>;
			bias-pull-up;
		};
	};
	bq25970_aux_irq_pins_default: bq25970_aux_irq_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO17__FUNC_GPIO17>;
			slew-rate = <0>;
			bias-pull-up;
		};
	};
	fsa9685_irq_pins_default: fsa9685_irq_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO16__FUNC_GPIO16>;
			slew-rate = <0>;
			bias-pull-up;
		};
	};

	sm5450_irq_pins_default: sm5450_irq_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO17__FUNC_GPIO17>;
			slew-rate = <0>;
			bias-pull-up;
		};
	};
	cw2217_irq_pins_default: cw2217_irq_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
			slew-rate = <0>;
			bias-pull-up;
		};
	};
	rt9426a_irq_pins_default: rt9426a_irq_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
			slew-rate = <0>;
			bias-pull-up;
		};
	};
        battct_swi_pins_default: battct_swi_pins_default {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO20__FUNC_GPIO20>;
                        slew-rate = <0>;
                        bias-disabled;
                        input-enable;
                        drive-strength = <3>;
                };
        };
        battct_id_pins_default: battct_id_pins_default {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
                        slew-rate = <0>;
                        bias-disabled;
                        output-high;
                };
        };
};

&huawei_batt_identify {
        pinctrl-names = "default";
        pinctrl-0 = <&battct_id_pins_default>;
        gpios = <&pio 19 0x0>;
        id_voltage_gpiov = <0 1>;
        id_sn_gpiov = <0 0>;
        status = "ok";
};

&huawei_batt_info {
        status = "ok";
        shield_ct_sign = <3>;
        battery_checker@0 {
                matchable = <&sle95250>;
                status = "ok";
        };
};

&sle95250 {
        pinctrl-names = "default";
        pinctrl-0 = <&battct_swi_pins_default>;
        onewire-gpio = <&pio 20 0x0>;
        product_id0 = <1>;
        product_id2 = <3>;
        gpio_sn_mode_val = <0>;
        dip_check = <0>;
        gpio_swi = <20>;
        gpio_id_mode = <19>;
        gpio_swi_drv = <3>;
        status = "ok";
};

&i2c7 {
	bq25970@65 {
		compatible = "bq25970";
		pinctrl-names = "default";
		pinctrl-0 = <&bq25970_main_irq_pins_default>;
		gpio_int = <&pio 23 0x0>;
		switching_frequency = <675>;
		sense_r_config = <20>;
		sense_r_actual = <10>;
		reg = <0x65>;
		ibus_ocp_th = <4250>;
		status = "disabled";
	};

	fairchild_fsa9685@25 {
		compatible = "huawei,fairchild_fsa9685";
		reg = <0x25>;
		pinctrl-names = "default";
		pinctrl-0 = <&fsa9685_irq_pins_default>;
		fairchild_fsa9685,gpio-intb = <&pio 16 0x0>;
		usbid-enable = <0>;
		fcp_support = <1>;
		scp_support = <1>;
		mhl_detect_disable = <1>;
		power_by_5v = <1>;
		close_bc12 = <1>;
		need_other_bc12 = <0>;
		ignore_force_ac = <1>;
		/* for rt8979 */
		interrupt-names = "vbus_change", "device_change", "detach",
			"attach";
		/* auto_switch; */
		scp;
		dcd;
		dcd_timeout = <600>;  /* ms */
		intb_watchdog = <1000>;  /* ms */
		ovp_sel = <14500000>;  /* uV */
		status = "disabled";
	};

	rt9426a_fg@55 {
		compatible = "richtek,rt9426a";
		reg = <0x55>;
		status = "disabled";
		rt,bat_name = "rt_battery";
		pinctrl-names = "default";
		pinctrl-0 = <&rt9426a_irq_pins_default>;
		interrupts-extended = <&pio 18 0>;
		ntc_compensation_is = <1>;
		ntc_temp_compensation_para =
			"11000", "110",
			"10000", "100",
			"9000", "80",
			"8000", "60",
			"7000", "50",
			"6000", "40",
			"5000", "30",
			"3000", "20",
			"2000", "10";
		battery0{
			batt_name = "AYXZGA";
			#include "rt9426a_AYXZGA_4300mah_4V45_BT217.dtsi"
		};
		battery1{
			batt_name = "BXCZGA";
			#include "rt9426a_BXCZGA_4300mah_4V45_BT217.dtsi"
		};
	};
	cw2217_fg@64 {
		reg = <0x64>;
		compatible = "cellwise,cw2217";
		status = "disabled";
		design_capacity = <3900>;
		pinctrl-names = "default";
		pinctrl-0 = <&cw2217_irq_pins_default>;
		cw2217,gpio-intb = <&pio 18 0x0>;
		ntc_compensation_is = <1>;
		ntc_temp_compensation_para =
			"11000", "140",
			"10000", "120",
			"9000", "100",
			"8000", "80",
			"7000", "60",
			"6000", "50",
			"5000", "40",
			"3000", "20",
			"2000", "10";
		battery0{
			batt_name = "BXCZGA";
			#include "CW_BXCZGA_4460_4300mah_BT217.dtsi"
		};
		battery1{
			batt_name = "AYXZGA";
			#include "CW_AYXZGA_4460_4300mah_BT217.dtsi"
		};
	};
};
&i2c0 {
	bq25970@65 {
		compatible = "bq25970";
		pinctrl-names = "default";
		pinctrl-0 = <&bq25970_aux_irq_pins_default>;
		gpio_int = <&pio 17 0x0>;
		ic_role = <1>;
		switching_frequency = <675>;
		sense_r_config = <20>;
		sense_r_actual = <10>;
		reg = <0x65>;
		ibus_ocp_th = <4250>;
		status = "disabled";
	};

	sm5450@6F{
		compatible = "sm5450";
		reg = <0x6F>;
		pinctrl-names = "default";
		pinctrl-0 = <&sm5450_irq_pins_default>;
		intr_gpio_num = <17>;
		intr_gpio = <&pio 17 0>;
		ic_role = <1>;
		support_unbalanced_current_sc = <0>;
		adc_channel_vbat_sys = <14>;
		fcp_support = <1>;
		scp_support = <1>;
		lvc_ibat_regulator = <12200>;
		lvc_vbat_regulator = <4500>;
		lvc_vout_regulator = <4550>;
		lvc_ibus_regulator = <5600>;
		sc_ibat_regulator = <12200>;
		sc_vbat_regulator = <4500>;
		sc_vout_regulator = <4550>;
		sc_ibus_regulator = <5600>;
		lvc_vusb2vbus_drop_en = <1>;
		sc_vusb2vbus_drop_en = <1>;
		bat_comp = <0>;
		vclamp = <0>;
		r_coul_mohm = <2>;
		status = "disabled";
	};
};
