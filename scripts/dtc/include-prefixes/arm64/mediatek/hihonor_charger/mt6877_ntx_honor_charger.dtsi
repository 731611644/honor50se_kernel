	status = "disabled";
};

&mt6360_pmu {
	mt6360,intr_gpio_num = <4>; /* direct defined GPIO num */
	mt6360,intr_gpio = <&pio 4 0x0>;
	chg {
		ircmp_resistor = <25000>;
	};
};

&mt6360_pmic {
	pwr_off_seq = [04 00 00 02];
};

&mt6360_typec {
	mt6360pd,intr_gpio_num = <5>; /* direct defined GPIO num */
	mt6360pd,intr_gpio = <&pio 5 0x0>;
};

&pio {
	mt6360_pd_eint_init: pd_eint_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO5__FUNC_GPIO5>,<PINMUX_GPIO4__FUNC_GPIO4>;
			slew-rate = <0>;
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_10>;
		};
	};
};

